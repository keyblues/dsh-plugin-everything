{
  "name": "dsh-plugin-everything",
  "version": "1.1.0",
  "description": "DeepSeek Harness (DSH) plugin: whole-disk file search through the official voidtools Everything SDK, called in-process over N-API FFI — millisecond-level queries without es.exe or an HTTP server, plus dedicated Web UI tool cards. DSH 插件：经官方 Everything SDK 在进程内查询全盘索引，毫秒级返回路径、大小与修改时间，无需 es.exe 与 HTTP 服务，并提供 Web 工具卡片。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "everything",
    "voidtools",
    "file-search",
    "search",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "author": {
    "name": "keyblues",
    "url": "https://github.com/keyblues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keyblues/dsh-plugin-everything.git"
  },
  "homepage": "https://github.com/keyblues/dsh-plugin-everything#readme",
  "bugs": {
    "url": "https://github.com/keyblues/dsh-plugin-everything/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node scripts/host-meta-smoke.mjs && node scripts/render-smoke.mjs"
  },
  "type": "module",
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "sdk-worker.cjs",
    "native/Everything64.dll",
    "vendor/koffi/index.cjs",
    "vendor/koffi/package.json",
    "vendor/koffi/LICENSE.txt",
    "vendor/koffi/src/koffi/index.cjs",
    "vendor/koffi/src/koffi/src/static.cjs",
    "vendor/@koromix/koffi-win32-x64/package.json",
    "vendor/@koromix/koffi-win32-x64/index.js",
    "vendor/@koromix/koffi-win32-x64/README.md",
    "vendor/@koromix/koffi-win32-x64/win32_x64/koffi.node",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  }
}
